NODE_ENV=development
PORT=4001
DATABASE_URL=mysql://innovia:change-this-local-password@127.0.0.1:3308/innovia
TEST_DATABASE_URL=mysql://innovia:change-this-local-password@127.0.0.1:3308/innovia_test
ADMIN_ORIGIN=http://localhost:5174
STOREFRONT_ORIGIN=http://localhost:3000
STOREFRONT_API_URL=http://127.0.0.1:4001
DEMO_PASSWORD=Set-a-local-demo-password
BOOTSTRAP_ADMIN_EMAIL=operator@innovia.local
BOOTSTRAP_ADMIN_PASSWORD=Set-a-separate-admin-password


# At least 32 random characters; signs short-lived merchant previews.
APP_SIGNING_SECRET=

# Images are served through the API; private fitting photos require their owner.
# Local storage needs an absolute persistent path in production.
# Keep MEDIA_DIR during an S3 transition so existing local assets remain readable.
MEDIA_STORAGE=local
# When omitted during development, MEDIA_DIR defaults to .local/media.
# MEDIA_DIR=F:/SALLAM/INNOVIA FASHION OS/.local/media
MEDIA_TENANT_LIMIT_MB=250

# Optional private S3 storage. See docs/STORAGE.md; versioning must never be enabled.
# Prefer an assigned IAM role. Keys, if supplied, stay in the API/maintenance environment.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=eu-west-1
# Leave endpoint empty for AWS. Custom production endpoints must use HTTPS.
MEDIA_S3_ENDPOINT=
MEDIA_S3_PREFIX=innovia
MEDIA_S3_FORCE_PATH_STYLE=false
# AES256 (default), aws:kms (requires KMS key), or provider (provider-managed encryption).
MEDIA_S3_ENCRYPTION=AES256
MEDIA_S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional paid providers. Enable only after account eligibility, terms,
# processing location, privacy and test transactions have been approved.
AI_PROVIDER_APPROVED=false
FAL_KEY=
BILLING_PROVIDER_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used only by scripts/bootstrap.ts; plan prices remain editable by the operator.
BOOTSTRAP_STARTER_PRICE=299.00

# Backup key must be base64 of 32 random bytes, kept separately from backup files.
BACKUP_ENCRYPTION_KEY=
# BACKUP_DIR=/secure-backups/innovia
# MYSQLDUMP_PATH=C:/Program Files/MySQL/MySQL Server 8.4/bin/mysqldump.exe
# MYSQLCLIENT_PATH=C:/Program Files/MySQL/MySQL Server 8.4/bin/mysql.exe
# Restore tooling only accepts an empty isolated database/folder ending in _restore_test.
RESTORE_DATABASE_URL=
RESTORE_MEDIA_DIR=

# Redis is required in production; development can use the single-process runner.
# Use a dedicated noeviction instance with persistence for BullMQ.
REDIS_URL=
# Set to the exact number of trusted reverse proxy hops in your deployment.
TRUST_PROXY_HOPS=0

# Local recovery emails are saved to .local/emails during development.
MAIL_TRANSPORT=local
MAIL_PROVIDER_APPROVED=false
RESEND_API_KEY=
MAIL_FROM=

PUSH_PROVIDER_APPROVED=false
EXPO_ACCESS_TOKEN=

# This browser token must be scoped to your HTTPS storefront origins in Snap's portal.
AR_PROVIDER_APPROVED=false
CAMERA_KIT_WEB_TOKEN=
