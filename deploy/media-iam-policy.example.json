{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerifyPrivatePhotoRetention",
      "Effect": "Allow",
      "Action": "s3:GetBucketVersioning",
      "Resource": "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET"
    },
    {
      "Sid": "ListMediaForRecovery",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["innovia/*"] } }
    },
    {
      "Sid": "ManagePrivateMediaObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_DEDICATED_BUCKET/innovia/*"
    }
  ]
}
